# Copia a .env.local solo si todavía no existe. No publiques secretos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Checkout Pro: origen HTTPS público, sin ruta ni barra final.
APP_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=test

# Solo si usas el endpoint HTTP para liberar reservas periódicamente.
CRON_SECRET=

# Correos transaccionales con Resend (opcional; sin estas variables no se envían correos).
# EMAIL_FROM debe usar un dominio verificado en Resend, p. ej. "Nutricion Laguna RR <pedidos@tu-dominio.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Opcional: número de WhatsApp de atención, solo dígitos con lada de país (p. ej. 5213312345678).
NEXT_PUBLIC_WHATSAPP=
